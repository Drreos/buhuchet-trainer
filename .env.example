# TikTok API настройки (опционально, если используете TikTok API)
TIKTOK_ACCESS_TOKEN=your_access_token_here
TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here

# Пути к папкам
INPUT_VIDEOS_DIR=input_videos
OUTPUT_VIDEOS_DIR=output_videos
TEMP_DIR=temp

# Настройки генерации видео
MAX_VIDEO_DURATION=60
MIN_VIDEO_DURATION=15
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Настройки загрузки
AUTO_UPLOAD=False
VIDEOS_PER_DAY=10
UPLOAD_DELAY_MIN=3600

# Настройки генерации вариаций
VARIATION_COUNT=10
ENABLE_EFFECTS=True
ENABLE_SPEED_VARIATIONS=True
ENABLE_CROPS=True

# Настройки рекламы и брендинга для Majestic Gift
BRAND_NAME=Majestic Gift
ENABLE_BRANDING=True
BRAND_TEXT_COLOR=white
BRAND_FONT_SIZE=60
WATERMARK_TEXT=Majestic Gift
AD_TEXTS=Majestic Gift 🎰|Выигрывай больше!|Играй сейчас!|🎁 Большие призы|Крупные выигрыши|Успей выиграть!|Твой шанс здесь!|Играй и выигрывай!
